{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "installCommand": "npm ci --legacy-peer-deps",
      "buildCommand": "npm run build"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "app.main:app",
      "functions": {
        "app/main.py": {
          "maxDuration": 300,
          "excludeFiles": "{tests/**,**/__pycache__/**,requirements-lock.txt,.pytest_cache/**,.ruff_cache/**}"
        }
      }
    }
  },
  "rewrites": [
    {"source": "/api/v1/:path*", "destination": {"service": "backend"}},
    {"source": "/health", "destination": {"service": "backend"}},
    {"source": "/docs", "destination": {"service": "backend"}},
    {"source": "/openapi.json", "destination": {"service": "backend"}},
    {"source": "/:path*", "destination": {"service": "frontend"}}
  ]
}
